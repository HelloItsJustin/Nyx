# Non-secret Nyx defaults. Do not add personal access tokens to this file.

# API keys are collected and validated in the CLI for each session.
GOOGLE_GEMINI_API_KEY=
GROQ_API_KEY=

# Local executable paths. Leave DOCKER_BINARY_PATH blank when Docker is on PATH.
TRUFFLEHOG_BINARY_PATH=trufflehog
DOCKER_BINARY_PATH=

# Auto-PR repository and isolated Phantom Runtime settings.
GITHUB_TARGET_OWNER=HelloItsJustin
GITHUB_TARGET_REPO=FinForge
SANDBOX_NETWORK_MODE=none
NYX_PHANTOM_IMAGE=python:3.12-slim
NYX_PHANTOM_TIMEOUT_SECONDS=30
NYX_PORT=8000
